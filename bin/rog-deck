#!/usr/bin/env python3
"""rog-deck - backend for the ROG Deck Omarchy plugin.

Everything goes through interfaces a normal user may touch: asusd on the
system bus, power-profiles-daemon (via omarchy-powerprofiles-set), logind
(brightnessctl), sysfs reads and hyprctl. FN-lock calls the user's own
`fnlock` tool, which carries its own sudoers rule. The root steps go through
pkexec: Integrated GPU mode (installing supergfxctl the first time and
writing /etc/supergfxd.conf), and installing the power helper
(bin/rog-deck-power) that sets CPU power limits and Wi-Fi power save.

  rog-deck status                          one JSON snapshot of everything the panel shows
  rog-deck profile <name|next|prev>        set the power mode for the current power source
  rog-deck takeover                        stop asusd switching profiles on plug/unplug

  rog-deck kbd brightness <0-3>
  rog-deck kbd idle-off <level>            remember the level, then dim to <level>
  rog-deck kbd idle-on                     put the remembered level back
  rog-deck aura <effect> [--colour hex] [--colour2 hex] [--speed low|med|high] [--direction d]
                                           effect: static breathe rainbow-cycle rainbow-wave pulse
  rog-deck aura-power <boot> <awake> <sleep> <shutdown>   each 0 or 1

  rog-deck anime on|off
  rog-deck anime brightness <0-3>
  rog-deck anime builtins <boot> <awake> <sleep> <shutdown>
  rog-deck anime option <unplugged|suspended|lid> <on|off>

  rog-deck battery limit <20-100>
  rog-deck battery oneshot
  rog-deck armoury <name> <value>
  rog-deck refresh <hz>
  rog-deck fnlock on|off

  rog-deck power                           JSON: CPU limit support, ranges, what is applied
  rog-deck power limit <watts>             cap the CPU in Silent: sustained <watts>, boosts raised to the firmware minimum
  rog-deck power off                       hand the CPU limits back to the firmware
  rog-deck power setup | uninstall         install or remove the root helper and its polkit rule
  rog-deck saver screen <0-4>              panel power savings level (0 off)
  rog-deck saver wifi on|off               Wi-Fi power save

  rog-deck gpu                             JSON: running mode, mode after restart, choices
  rog-deck gpu set <integrated|hybrid|dedicated> [--restart]
  rog-deck gpu restart                     apply a pending GPU switch and reboot

  rog-deck fans                           JSON: every mode's curves
  rog-deck fans set <mode> <cpu|gpu|both> <t:p,...>   8 points, p in percent; turns custom on
  rog-deck fans custom <mode> <on|off>
  rog-deck fans preset <mode> <silent|stock|cool|max>
  rog-deck fans reset <mode>

  rog-deck version                         the installed plugin version
  rog-deck update check                    JSON: is a newer version on the plugin's git remote
  rog-deck update apply                    fast-forward to it (local edits are stashed first)
"""

import glob
import json
import os
import pwd
import re
import shutil
import subprocess
import sys
import time

# The shell reloads every plugin when a file appears in the plugin folder.
sys.dont_write_bytecode = True

ASUSD = "xyz.ljones.Asusd"
ROOT = "/xyz/ljones"
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
OMARCHY_PROFILES = os.path.join(STATE_HOME, "omarchy", "powerprofiles")
KBD_IDLE_FILE = os.path.join(RUNTIME, "rog-deck", "kbd-idle")
OMARCHY_PATH = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"

SUPERGFXD_CONF = "/etc/supergfxd.conf"
SUPERGFXD_DELAY = "/etc/systemd/system/supergfxd.service.d/delay-start.conf"
FORCE_IGPU_HOOK = "/usr/lib/systemd/system-sleep/force-igpu"
GPU_MODES = ("integrated", "hybrid", "dedicated")
# Run as root through pkexec; $1 is Integrated or Hybrid, $2 OMARCHY_PATH.
# Mirrors omarchy-toggle-hybrid-gpu, including installing supergfxctl the
# first time: Integrated needs supergfxd to start late (it can freeze boot
# otherwise) and a sleep hook that turns the dGPU back off after resume,
# since the G14 wakes up in Hybrid.
#
# Integrated is supergfxd's job rather than the firmware dgpu_disable flag:
# asusd can only write that flag at shutdown, and by then nvidia_drm (loaded
# from the initramfs) holds the card, so the write fails with EIO and the
# laptop comes back up in Hybrid.
SUPERGFXD_SCRIPT = r"""
set -e
conf=/etc/supergfxd.conf
if [ ! -x /usr/bin/supergfxctl ]; then
  pacman -S --needed --noconfirm supergfxctl
fi
if [ ! -f "$conf" ]; then
  cat > "$conf" <<'CONF'
{
  "mode": "Hybrid",
  "vfio_enable": true,
  "vfio_save": false,
  "always_reboot": false,
  "no_logind": false,
  "logout_timeout_s": 180,
  "hotplug_type": "None"
}
CONF
fi
systemctl enable supergfxd.service >/dev/null 2>&1 || true
if [ "$1" = Integrated ]; then
  install -D -m 0644 "$2/default/systemd/system/supergfxd.service.d/delay-start.conf" %s
  install -D -m 0755 "$2/default/systemd/system-sleep/force-igpu" %s
  sed -i -e 's/"mode": "[^"]*"/"mode": "Integrated"/' -e 's/"vfio_enable": false/"vfio_enable": true/' "$conf"
else
  sed -i 's/"mode": "[^"]*"/"mode": "Hybrid"/' "$conf"
  rm -f %s %s
fi
""" % (SUPERGFXD_DELAY, FORCE_IGPU_HOOK, SUPERGFXD_DELAY, FORCE_IGPU_HOOK)

POWER_HELPER = "/usr/local/libexec/rog-deck-power"
POWER_RULE = "/etc/polkit-1/rules.d/49-rog-deck-power.rules"
POWER_STATE = "/run/rog-deck-power.json"
# Whether `power limit` switched Silent's custom fan curve on, so `power off`
# switches it back off. A curve the user turned on stays theirs.
POWER_OWNER = os.path.join(STATE_HOME, "rog-deck", "power.json")
# Run as root through pkexec; $1 is the helper to install, $2 the user the
# polkit rule lets run it without a password. The helper is copied, never
# run from the plugin folder: that folder is the user's to write, and a rule
# pointing into it would hand root to anything running as the user.
POWER_SETUP_SCRIPT = r"""
set -e
case "$2" in ''|*[!a-z0-9_-]*) echo "bad user name" >&2; exit 2;; esac
install -D -o root -g root -m 0755 "$1" /usr/local/libexec/rog-deck-power
tmp=/etc/polkit-1/rules.d/.49-rog-deck-power.rules.tmp
cat > "$tmp" <<RULE
// ROG Deck: $2, at the laptop, may run its power helper without a password.
// The helper only takes CPU limits inside the firmware's range for this
// laptop and Wi-Fi power save on or off.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/local/libexec/rog-deck-power" &&
        subject.user == "$2" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
RULE
chmod 0644 "$tmp"
mv -f "$tmp" /etc/polkit-1/rules.d/49-rog-deck-power.rules
"""
POWER_UNINSTALL_SCRIPT = r"""
[ -x /usr/local/libexec/rog-deck-power ] && /usr/local/libexec/rog-deck-power reset || true
rm -f /etc/polkit-1/rules.d/49-rog-deck-power.rules /usr/local/libexec/rog-deck-power /run/rog-deck-power.json
"""
# The Hyprland monitor profile ROG Deck keeps for the laptop screen on its
# own, so hyprmoncfgd has an exact match to hold the refresh rate in.
LAPTOP_PROFILE = "Laptop"

# Display order for the mode tiles, quietest first.
PROFILE_ORDER = ["power-saver", "balanced", "performance"]
# asusd PlatformProfile ids.
ASUSD_BALANCED, ASUSD_PERFORMANCE, ASUSD_QUIET, ASUSD_LOWPOWER = 0, 1, 2, 3

AURA_EFFECTS = {"static": 0, "breathe": 1, "rainbow-cycle": 2, "rainbow-wave": 3, "pulse": 10}
SPEEDS = ("low", "med", "high")
DIRECTIONS = ("up", "down", "left", "right")
ANIME_OPTIONS = {"unplugged": "OffWhenUnplugged", "suspended": "OffWhenSuspended", "lid": "OffWhenLidClosed"}
ANIME_BUILTINS = {
    "boot": ("GlitchConstruction", "StaticEmergence"),
    "awake": ("BinaryBannerScroll", "RogLogoGlitch"),
    "sleep": ("BannerSwipe", "Starfield"),
    "shutdown": ("GlitchOut", "SeeYa"),
}

# Percent duty per point. Silent keeps the fans off until about 70 °C.
FAN_PRESETS = {
    "silent": {"cpu": "45:0,55:0,62:0,68:0,72:15,80:30,88:55,97:90",
               "gpu": "45:0,55:0,62:0,68:0,72:15,80:30,88:55,97:90"},
    "stock": {"cpu": "50:1,55:13,60:30,64:32,74:44,78:51,82:59,97:100",
              "gpu": "50:1,55:11,60:18,64:32,74:42,78:51,82:59,97:91"},
    "cool": {"cpu": "40:10,50:25,58:40,65:55,72:70,80:85,88:95,97:100",
             "gpu": "40:10,50:25,58:40,65:55,72:70,80:85,88:95,97:100"},
    "max": {"cpu": "30:100,40:100,50:100,60:100,70:100,80:100,90:100,97:100",
            "gpu": "30:100,40:100,50:100,60:100,70:100,80:100,90:100,97:100"},
}


class Failure(Exception):
    pass


def fail(message):
    raise Failure(message)


def run(cmd, timeout=3):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def act(cmd, timeout=10):
    """Run a command that changes something; raise with its stderr on failure."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        fail("%s is not installed" % cmd[0])
    except subprocess.TimeoutExpired:
        fail("%s timed out" % " ".join(cmd[:3]))
    if out.returncode != 0:
        detail = (out.stderr or out.stdout).strip().splitlines()
        fail("%s failed: %s" % (" ".join(cmd[:3]), detail[-1] if detail else "exit %d" % out.returncode))
    return out.stdout


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def read_int(path):
    value = read(path)
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def busctl(*args):
    out = run(["busctl", "--system", "-j", *args])
    if out is None:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def unwrap(value):
    """Strip busctl's {"type", "data"} variant wrappers, recursively."""
    if isinstance(value, dict) and set(value) == {"type", "data"}:
        return unwrap(value["data"])
    if isinstance(value, dict):
        return {key: unwrap(item) for key, item in value.items()}
    if isinstance(value, list):
        return [unwrap(item) for item in value]
    return value


def get_all(path, interface, service=ASUSD):
    """All properties of one D-Bus object as a plain dict, or None."""
    reply = busctl("call", service, path, "org.freedesktop.DBus.Properties", "GetAll", "s", interface)
    if not reply or not reply.get("data"):
        return None
    return {key: unwrap(value) for key, value in reply["data"][0].items()}


def set_property(path, interface, prop, signature, *values):
    act(["busctl", "--system", "set-property", ASUSD, path, interface, prop, signature, *map(str, values)])


def call(path, interface, method, signature="", *args):
    cmd = ["busctl", "--system", "-j", "call", ASUSD, path, interface, method]
    if signature:
        cmd += [signature, *map(str, args)]
    out = act(cmd)
    return unwrap(json.loads(out)) if out.strip() else None


def asusd_objects():
    out = run(["busctl", "--system", "tree", "--list", ASUSD])
    return out.split() if out else []


def hwmon(name):
    for path in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(path + "/name") == name:
            return path
    return None


def on_ac():
    for supply in glob.glob("/sys/class/power_supply/*"):
        if read(supply + "/type") in ("Mains", "USB") and read(supply + "/online") == "1":
            return True
    return False


def hex_colour(rgb):
    try:
        return "%02x%02x%02x" % tuple(rgb)
    except (TypeError, ValueError):
        return None


def valid_hex(value):
    value = str(value or "").lstrip("#").lower()
    if len(value) != 6 or any(c not in "0123456789abcdef" for c in value):
        fail("colour must be six hex digits, got %r" % value)
    return value


def kbd_led():
    for path in sorted(glob.glob("/sys/class/leds/*kbd_backlight*")):
        return path
    return None


def aura_path(objects=None):
    objects = objects if objects is not None else asusd_objects()
    return next((o for o in objects if o.startswith(ROOT + "/aura/") and o != ROOT + "/aura/anime"), None)


# ---------------------------------------------------------------- status

def ppd_props():
    return get_all("/org/freedesktop/UPower/PowerProfiles", "org.freedesktop.UPower.PowerProfiles",
                   "org.freedesktop.UPower.PowerProfiles") or {}


def profile_status(platform=None, ppd=None):
    ppd = ppd if ppd is not None else ppd_props()
    names = [p.get("Profile") for p in ppd.get("Profiles") or []]
    choices = [name for name in PROFILE_ORDER if name in names]
    platform = platform if platform is not None else (get_all(ROOT, "xyz.ljones.Platform") or {})
    return {
        "active": ppd.get("ActiveProfile"),
        "choices": choices,
        "saved": {
            "ac": read(os.path.join(OMARCHY_PROFILES, "ac")),
            "battery": read(os.path.join(OMARCHY_PROFILES, "battery")),
        },
        "asusdAutoSwitch": bool(platform.get("ChangePlatformProfileOnAc")
                                or platform.get("ChangePlatformProfileOnBattery")),
    }


def led_power(raw):
    """asusd LedPower is a list of (zone, boot, awake, sleep, shutdown); 1 is the keyboard."""
    try:
        for zone in raw[0]:
            if zone[0] == 1:
                return dict(zip(["boot", "awake", "sleep", "shutdown"], [bool(v) for v in zone[1:5]]))
    except (TypeError, IndexError):
        pass
    return None


def keyboard_status(objects):
    led = kbd_led()
    status = {
        "brightness": read_int(led + "/brightness") if led else None,
        "max": read_int(led + "/max_brightness") if led else None,
        "idleOff": os.path.exists(KBD_IDLE_FILE),
    }
    path = aura_path(objects)
    aura = get_all(path, "xyz.ljones.Aura") if path else None
    if aura:
        data = aura.get("LedModeData") or [None] * 6
        status.update({
            "mode": aura.get("LedMode"),
            "modes": aura.get("SupportedBasicModes") or [],
            "colour1": hex_colour(data[2]),
            "colour2": hex_colour(data[3]),
            "speed": str(data[4] or "").lower() or None,
            "direction": str(data[5] or "").lower() or None,
            "power": led_power(aura.get("LedPower")),
        })
    return status


def anime_status(objects):
    path = ROOT + "/aura/anime"
    if path not in objects:
        return None
    anime = get_all(path, "xyz.ljones.Anime")
    if not anime:
        return None
    builtins = anime.get("BuiltinAnimations") or [None] * 4
    return {
        "enabled": anime.get("EnableDisplay"),
        "brightness": anime.get("Brightness"),
        "builtinsEnabled": anime.get("BuiltinsEnabled"),
        "builtins": dict(zip(["boot", "awake", "sleep", "shutdown"], builtins)),
        "offWhenUnplugged": anime.get("OffWhenUnplugged"),
        "offWhenSuspended": anime.get("OffWhenSuspended"),
        "offWhenLidClosed": anime.get("OffWhenLidClosed"),
    }


def armoury_status(objects):
    attrs = {}
    prefix = ROOT + "/asus_armoury/"
    for path in objects:
        if not path.startswith(prefix):
            continue
        props = get_all(path, "xyz.ljones.AsusArmoury")
        if not props or "current_value" not in (props.get("AvailableAttrs") or []):
            continue
        attrs[path[len(prefix):]] = {
            "value": props.get("CurrentValue"),
            "values": props.get("PossibleValues") or [],
            "min": props.get("MinValue"),
            "max": props.get("MaxValue"),
        }
    return attrs


def dgpu_status():
    """Runtime PM state of the discrete GPU, read without waking it."""
    for dev in glob.glob("/sys/bus/pci/devices/*"):
        if read(dev + "/vendor") != "0x10de" or not (read(dev + "/class") or "").startswith("0x03"):
            continue
        return {"state": read(dev + "/power/runtime_status") or "unknown", "path": dev}
    return {"state": "absent", "path": None}


def sensors(dgpu):
    temps = {"cpu": None, "gpu": None, "gpuSource": None}
    watts = {"igpu": None, "dgpu": None}
    k10 = hwmon("k10temp") or hwmon("zenpower") or hwmon("coretemp")
    if k10:
        value = read_int(k10 + "/temp1_input")
        temps["cpu"] = round(value / 1000, 1) if value is not None else None
    amdgpu = hwmon("amdgpu")
    if amdgpu:
        power = read_int(amdgpu + "/power1_input") or read_int(amdgpu + "/power1_average")
        watts["igpu"] = round(power / 1e6, 1) if power is not None else None
    # Only ask nvidia-smi while the card is already awake: querying a
    # suspended dGPU would wake it and cost battery.
    if dgpu["state"] == "active" and shutil.which("nvidia-smi"):
        out = run(["nvidia-smi", "--query-gpu=temperature.gpu,power.draw",
                   "--format=csv,noheader,nounits"], timeout=2)
        if out:
            parts = [p.strip() for p in out.splitlines()[0].split(",")]
            try:
                temps["gpu"], temps["gpuSource"] = float(parts[0]), "nvidia"
                watts["dgpu"] = float(parts[1])
            except (ValueError, IndexError):
                pass
    if temps["gpu"] is None and amdgpu:
        value = read_int(amdgpu + "/temp1_input")
        if value is not None:
            temps["gpu"], temps["gpuSource"] = round(value / 1000, 1), "amdgpu"
    fans = {"cpu": None, "gpu": None, "mid": None}
    asus = hwmon("asus")
    if asus:
        for n in range(1, 4):
            label = read("%s/fan%d_label" % (asus, n))
            if label:
                fans[label.replace("_fan", "")] = read_int("%s/fan%d_input" % (asus, n))
    return temps, watts, fans


def battery_status():
    bat = next(iter(sorted(glob.glob("/sys/class/power_supply/BAT*"))), None)
    if not bat:
        return None
    power = read_int(bat + "/power_now")
    if power is None:
        current, voltage = read_int(bat + "/current_now"), read_int(bat + "/voltage_now")
        if current is not None and voltage is not None:
            power = current * voltage // 1_000_000
    return {
        "percent": read_int(bat + "/capacity"),
        "status": read(bat + "/status"),
        "limit": read_int(bat + "/charge_control_end_threshold"),
        "watts": round(power / 1e6, 1) if power is not None else None,
    }


def panel_monitor():
    out = run(["hyprctl", "monitors", "-j"])
    if not out:
        return None
    try:
        monitors = json.loads(out)
    except ValueError:
        return None
    return next((m for m in monitors if m.get("name", "").startswith("eDP")), None)


def panel_modes(panel):
    """{rounded hz: exact mode string} at the panel's current resolution."""
    size = "%dx%d" % (panel["width"], panel["height"])
    modes = {}
    for mode in panel.get("availableModes", []):
        res, _, hz = mode.partition("@")
        if res == size:
            try:
                modes[round(float(hz.rstrip("Hz")))] = "%s@%s" % (res, hz.rstrip("Hz"))
            except ValueError:
                pass
    return modes


def display_status():
    panel = panel_monitor()
    if not panel:
        return None
    return {"name": panel["name"], "refresh": round(panel.get("refreshRate", 0)),
            "rates": sorted(panel_modes(panel))}


def fnlock_tool():
    tool = shutil.which("fnlock")
    local = os.path.expanduser("~/.local/bin/fnlock")
    if not tool and os.access(local, os.X_OK):
        tool = local
    return tool


def fnlock_status():
    tool = fnlock_tool()
    if not tool:
        return {"available": False, "on": False}
    out = run([tool, "status"])
    return {"available": True, "on": (out or "").strip() == "on"}


def status():
    objects = asusd_objects()
    platform = get_all(ROOT, "xyz.ljones.Platform")
    ppd = ppd_props()
    dgpu = dgpu_status()
    temps, watts, fans = sensors(dgpu)
    return {
        "version": manifest().get("version"),
        "asusd": platform is not None,
        "asusdVersion": platform.get("Version") if platform else None,
        "model": read("/sys/class/dmi/id/product_name"),
        "ac": on_ac(),
        "profile": profile_status(platform or {}, ppd),
        "keyboard": keyboard_status(objects),
        "anime": anime_status(objects),
        "armoury": armoury_status(objects),
        "dgpu": dgpu["state"],
        "temps": temps,
        "watts": watts,
        "fans": fans,
        "battery": battery_status(),
        "display": display_status(),
        "fnlock": fnlock_status(),
        "gpu": gpu_status(),
        "power": power_status(),
        "saver": {"screen": screen_saving(ppd), "wifi": wifi_powersave()},
    }


# ------------------------------------------------------------- profiles

def set_profile(arg):
    current = profile_status()
    choices = current["choices"] or PROFILE_ORDER
    aliases = {"quiet": "power-saver", "silent": "power-saver", "turbo": "performance"}
    target = aliases.get(arg, arg)
    if target in ("next", "prev"):
        index = choices.index(current["active"]) if current["active"] in choices else 0
        step = 1 if target == "next" else -1
        target = choices[(index + step) % len(choices)]
    if target not in choices:
        fail("unknown profile: %s (choices: %s)" % (arg, ", ".join(choices)))
    act(["omarchy-powerprofiles-set", "ac" if on_ac() else "battery", target])
    print(target)


def takeover():
    """Leave plug/unplug profile switching to Omarchy alone.

    Omarchy's battery service and asusd both switch the profile when the
    charger changes, each from its own memory, so whichever runs last wins.
    """
    for prop in ("ChangePlatformProfileOnAc", "ChangePlatformProfileOnBattery"):
        set_property(ROOT, "xyz.ljones.Platform", prop, "b", "false")
    print("ok")


# ------------------------------------------------------------- keyboard

def brightnessctl(*args):
    led = kbd_led()
    if not led:
        fail("no keyboard backlight found")
    act(["brightnessctl", "-q", "-d", os.path.basename(led), *args])


def kbd_brightness(level):
    led = kbd_led()
    top = read_int(led + "/max_brightness") if led else 3
    level = int(level)
    if not 0 <= level <= (top or 3):
        fail("brightness must be 0-%d" % (top or 3))
    # A manual change ends any pending auto-off restore.
    clear_idle_file()
    brightnessctl("set", str(level))


def clear_idle_file():
    try:
        os.remove(KBD_IDLE_FILE)
    except OSError:
        pass


def kbd_idle_off(level):
    led = kbd_led()
    current = read_int(led + "/brightness") if led else None
    level = int(level)
    if current is None or current <= level or os.path.exists(KBD_IDLE_FILE):
        return
    os.makedirs(os.path.dirname(KBD_IDLE_FILE), exist_ok=True)
    with open(KBD_IDLE_FILE, "w") as f:
        f.write("%d %d\n" % (current, level))
    brightnessctl("set", str(level))


def kbd_idle_on():
    raw = read(KBD_IDLE_FILE)
    clear_idle_file()
    if not raw:
        return
    try:
        saved, dimmed = (int(v) for v in raw.split())
    except ValueError:
        return
    led = kbd_led()
    # Someone else changed it while we were dimmed (the brightness keys,
    # the lock screen putting its own level back): theirs wins.
    if led and read_int(led + "/brightness") != dimmed:
        return
    brightnessctl("set", str(saved))
    # The lock screen blanks the keyboard with brightnessctl's save slot and
    # restores from it on wake. If it blanked while we had the light off, the
    # slot holds our dimmed level; overwrite it so unlock lands on ours.
    brightnessctl("-s", "set", str(saved))


def aura(args):
    if not args or args[0] not in AURA_EFFECTS:
        fail("effect must be one of: " + ", ".join(AURA_EFFECTS))
    effect, opts = args[0], parse_opts(args[1:], {"--colour", "--colour2", "--speed", "--direction"})
    cmd = ["asusctl", "aura", "effect", effect]
    colour = valid_hex(opts.get("--colour", "ffffff"))
    speed = opts.get("--speed", "med")
    if speed not in SPEEDS:
        fail("speed must be one of: " + ", ".join(SPEEDS))
    if effect in ("static", "pulse"):
        cmd += ["-c", colour]
    elif effect == "breathe":
        cmd += ["--colour", colour, "--colour2", valid_hex(opts.get("--colour2", "000000")), "--speed", speed]
    elif effect == "rainbow-cycle":
        cmd += ["--speed", speed]
    elif effect == "rainbow-wave":
        direction = opts.get("--direction", "right")
        if direction not in DIRECTIONS:
            fail("direction must be one of: " + ", ".join(DIRECTIONS))
        cmd += ["--speed", speed, "--direction", direction]
    # The keyboard can keep animating the old effect while asusd reports the
    # new one (seen going breathe -> static on a GA402). Blanking it first and
    # re-sending its power state and brightness afterwards makes it take hold.
    led = kbd_led()
    level = read_int(led + "/brightness") if led else None
    act(["asusctl", "leds", "set", "off"])
    try:
        act(cmd)
        power = led_power((get_all(aura_path(), "xyz.ljones.Aura") or {}).get("LedPower"))
        if power:
            aura_power(["1" if power[slot] else "0" for slot in ("boot", "awake", "sleep", "shutdown")])
    finally:
        names = ["off", "low", "med", "high"]
        act(["asusctl", "leds", "set", names[max(0, min(3, level if level is not None else 2))]])


def aura_power(args):
    if len(args) != 4 or any(a not in ("0", "1") for a in args):
        fail("aura-power takes four 0/1 values: boot awake sleep shutdown")
    cmd = ["asusctl", "aura", "power", "keyboard"]
    for name, value in zip(["--boot", "--awake", "--sleep", "--shutdown"], args):
        if value == "1":
            cmd.append(name)
    act(cmd)


def parse_opts(args, allowed):
    opts = {}
    i = 0
    while i < len(args):
        if args[i] not in allowed or i + 1 >= len(args):
            fail("unexpected argument: " + args[i])
        opts[args[i]] = args[i + 1].lower()
        i += 2
    return opts


# ---------------------------------------------------------------- anime

def on_off(value):
    if value not in ("on", "off"):
        fail("expected on or off, got %r" % value)
    return "true" if value == "on" else "false"


def anime(args):
    path = ROOT + "/aura/anime"
    if not args:
        fail("anime needs a command")
    command = args[0]
    if command in ("on", "off"):
        act(["asusctl", "anime", "--enable-display", on_off(command)])
    elif command == "brightness" and len(args) == 2:
        level = int(args[1])
        if not 0 <= level <= 3:
            fail("brightness must be 0-3")
        set_property(path, "xyz.ljones.Anime", "Brightness", "u", level)
    elif command == "builtins" and len(args) == 5:
        cmd = ["asusctl", "anime", "set-builtins"]
        for slot, name in zip(["boot", "awake", "sleep", "shutdown"], args[1:]):
            if name not in ANIME_BUILTINS[slot]:
                fail("%s animation must be one of: %s" % (slot, ", ".join(ANIME_BUILTINS[slot])))
            cmd += ["--" + slot, name]
        act(cmd + ["--set", "true"])
        # set-builtins alone leaves the panel dark if the built-in animations
        # were switched off (an image from another tool); switch them back on.
        act(["asusctl", "anime", "--enable-powersave-anim", "true"])
        act(["asusctl", "anime", "--enable-display", "true"])
    elif command == "option" and len(args) == 3:
        if args[1] not in ANIME_OPTIONS:
            fail("option must be one of: " + ", ".join(ANIME_OPTIONS))
        set_property(path, "xyz.ljones.Anime", ANIME_OPTIONS[args[1]], "b", on_off(args[2]))
    else:
        fail("unknown anime command: " + " ".join(args))


# ----------------------------------------------------- battery, firmware

def battery(args):
    if args == ["oneshot"]:
        act(["asusctl", "battery", "oneshot"])
    elif len(args) == 2 and args[0] == "limit":
        limit = int(args[1])
        if not 20 <= limit <= 100:
            fail("limit must be 20-100")
        act(["asusctl", "battery", "limit", str(limit)])
    else:
        fail("battery limit <20-100> | battery oneshot")


def armoury(args):
    if len(args) != 2:
        fail("armoury <name> <value>")
    name, value = args
    attrs = armoury_status(asusd_objects())
    if name not in attrs:
        fail("this laptop has no firmware setting called " + name)
    allowed = attrs[name]["values"]
    if allowed and int(value) not in allowed:
        fail("%s must be one of %s" % (name, allowed))
    act(["asusctl", "armoury", "set", name, str(int(value))])


def refresh(hz):
    panel = panel_monitor()
    if not panel:
        fail("no built-in display found")
    modes = panel_modes(panel)
    target = int(round(float(hz)))
    if target not in modes:
        fail("the panel has no %d Hz mode (has %s)" % (target, ", ".join(map(str, sorted(modes)))))
    if round(panel.get("refreshRate", 0)) == target:
        return
    scale = panel.get("scale", 1)
    scale = int(scale) if float(scale).is_integer() else scale
    # Hyprland 0.56 reads a Lua config, which rejects `hyprctl keyword
    # monitor`; hl.monitor replaces the whole rule, so repeat position and scale.
    act(["hyprctl", "eval", 'hl.monitor({ output = "%s", mode = "%s", position = "%dx%d", scale = %s })'
         % (panel["name"], modes[target], panel["x"], panel["y"], scale)])
    hold_rate(target)


def hold_rate(target):
    """Save the new rate where hyprmoncfgd will keep it.

    The daemon puts the screens back the way the best-matching saved
    profile has them shortly after any runtime change. With only some of a
    profile's screens connected (the laptop off its desk) no profile is
    active, so the daemon falls back to the desk profile and its rate. The
    laptop screen alone gets a profile of its own for that.
    """
    if not shutil.which("hyprmoncfg"):
        return
    # Save what Hyprland shows, so wait for the mode switch to land first.
    for _ in range(30):
        panel = panel_monitor()
        if panel and round(panel.get("refreshRate", 0)) == target:
            break
        time.sleep(0.1)
    else:
        return
    # hyprmoncfg refuses while the screens are still reconnecting from the switch.
    info = None
    for _ in range(10):
        try:
            info = json.loads(run(["hyprmoncfg", "status", "--json"], timeout=5) or "")
            break
        except ValueError:
            time.sleep(0.3)
    if not isinstance(info, dict) or not (info.get("daemon") or {}).get("running"):
        return
    profile = info.get("active_profile")
    name = profile.get("name") if isinstance(profile, dict) else profile
    if not name:
        monitors = json.loads(run(["hyprctl", "monitors", "all", "-j"]) or "[]")
        laptop_only = len(monitors) == 1 and monitors[0].get("name", "").startswith("eDP")
        # Never overwrite a "Laptop" profile someone made with more screens in it.
        mine = next((p for p in info.get("profiles") or [] if p.get("name") == LAPTOP_PROFILE), None)
        if laptop_only and (mine is None or mine.get("output_count") == 1):
            name = LAPTOP_PROFILE
    if name:
        act(["hyprmoncfg", "save", str(name)])


def fnlock(args):
    if args not in (["on"], ["off"]):
        fail("fnlock on|off")
    tool = fnlock_tool()
    if not tool:
        fail("FN-lock is not set up (no fnlock command)")
    act([tool, args[0]])


# ------------------------------------------------ CPU limits, battery saver

def power_module():
    """bin/rog-deck-power loaded as a module, for its limits table."""
    import importlib.util
    from importlib.machinery import SourceFileLoader
    loader = SourceFileLoader("rog_deck_power", os.path.join(PLUGIN_DIR, "bin", "rog-deck-power"))
    spec = importlib.util.spec_from_loader("rog_deck_power", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def helper_version():
    """The installed helper's VERSION, read from its source rather than run."""
    match = re.search(r"^VERSION = (\d+)$", read(POWER_HELPER) or "", re.M)
    return int(match.group(1)) if match else None


def ppt_triple(watts, table):
    """Sustained at `watts`; the boosts follow it but never below their minimum.

    Model.pptTriple does the same for the panel's caption.
    """
    def clamp(value, bounds):
        return max(bounds[0], min(bounds[1], value))
    spl = clamp(watts, table["spl"])
    sppt = clamp(max(watts, spl), table["sppt"])
    return spl, sppt, clamp(max(watts, sppt), table["fppt"])


def power_status():
    helper = power_module()
    table = helper.LIMITS.get(helper.board())
    supported = bool(table) and all(helper.target(key) for key in ("spl", "sppt", "fppt"))
    installed = helper_version()
    try:
        with open(POWER_STATE) as f:
            applied = json.load(f)
    except (OSError, ValueError):
        applied = None
    current = table["ac" if on_ac() else "dc"] if table else None
    return {
        "supported": supported,
        "helper": "missing" if installed is None else ("outdated" if installed < helper.VERSION else "ok"),
        "ranges": {key: list(bounds) for key, bounds in current.items()} if current else None,
        # The slider covers the battery range: past 35 W sustained Silent stops being silent.
        "slider": list(table["dc"]["spl"]) if table else None,
        "applied": applied if isinstance(applied, dict) and "spl" in applied else None,
        "curveOwned": curve_owned(),
    }


def screen_saving(ppd):
    """amdgpu's panel power savings level, and whether power-profiles-daemon
    also drives it (its action only acts below 50% battery, so Battery saver
    switches it off and sets the level itself)."""
    info = next((a for a in ppd.get("ActionsInfo") or [] if a.get("Name") == "amdgpu_panel_power"), None)
    level = next((v for v in (read_int(p) for p in glob.glob("/sys/class/drm/card*-eDP-*/amdgpu/panel_power_savings"))
                  if v is not None), None)
    return {"available": level is not None, "level": level, "ppd": bool(info and info.get("Enabled"))}


def wifi_interfaces():
    return [os.path.basename(os.path.dirname(p)) for p in sorted(glob.glob("/sys/class/net/*/phy80211"))]


def wifi_powersave():
    for name in wifi_interfaces():
        out = run(["iw", "dev", name, "get", "power_save"])
        if out and ":" in out:
            return out.split(":", 1)[1].strip() == "on"
    return None


def root_script(script, args, what):
    """Run a shell script as root through pkexec, which asks for the password."""
    try:
        # Long enough for the password prompt plus a first package download.
        out = subprocess.run(["pkexec", "/bin/sh", "-c", script, "rog-deck", *args],
                             capture_output=True, text=True, timeout=600)
    except FileNotFoundError:
        fail("pkexec is not installed")
    except subprocess.TimeoutExpired:
        fail("timed out waiting for the password prompt")
    if out.returncode in (126, 127):
        fail("%s cancelled: no permission" % what)
    if out.returncode != 0:
        detail = (out.stderr or out.stdout).strip().splitlines()
        fail("%s failed: %s" % (what, detail[-1] if detail else "exit %d" % out.returncode))


def power_helper(*args):
    """Run the installed helper as root; its polkit rule needs no password."""
    if helper_version() is None:
        fail("the power helper isn't set up: run `rog-deck power setup`")
    try:
        out = subprocess.run(["pkexec", POWER_HELPER, *args], capture_output=True, text=True, timeout=20)
    except FileNotFoundError:
        fail("pkexec is not installed")
    except subprocess.TimeoutExpired:
        fail("the power helper timed out")
    if out.returncode in (126, 127):
        fail("no permission to run the power helper; set it up again from the panel")
    if out.returncode != 0:
        detail = (out.stderr or out.stdout).strip().splitlines()
        fail(detail[-1].replace("rog-deck-power: ", "") if detail else "power helper exit %d" % out.returncode)


def silent_curve(on=None):
    """Whether Silent runs its custom fan curve; with `on`, switch it.

    This firmware ignores the CPU limits unless the mode runs a custom fan
    curve (the kernel's table marks the GA402X the same way). asusd keeps a
    copy of the firmware curve as each mode's custom one until it is edited,
    so switching it on keeps the fans as they were.
    """
    profile_id = fan_profile_id("power-saver")
    if on is None:
        return any(fan["enabled"] for fan in fan_data(profile_id).values())
    call(ROOT, "xyz.ljones.FanCurves", "SetFanCurvesEnabled", "ub", profile_id, "true" if on else "false")


def curve_owned(value=None):
    if value is None:
        try:
            with open(POWER_OWNER) as f:
                return bool(json.load(f).get("curve"))
        except (OSError, ValueError, AttributeError):
            return False
    if value:
        os.makedirs(os.path.dirname(POWER_OWNER), exist_ok=True)
        with open(POWER_OWNER, "w") as f:
            json.dump({"curve": True}, f)
    else:
        try:
            os.remove(POWER_OWNER)
        except FileNotFoundError:
            pass


def power(args):
    if not args:
        print(json.dumps(power_status(), separators=(",", ":")))
    elif len(args) == 2 and args[0] == "limit":
        info = power_status()
        if not info["supported"]:
            fail("CPU power limits aren't supported on this laptop")
        watts = int(args[1])
        low, high = info["slider"]
        if not low <= watts <= high:
            fail("limit must be %d-%d W" % (low, high))
        if not silent_curve():
            silent_curve(True)
            curve_owned(True)
            # G-Helper waits the same before writing limits after fans.
            time.sleep(0.5)
        power_helper("ppt", *map(str, ppt_triple(watts, power_module().limits())))
    elif args == ["off"]:
        power_helper("reset")
        if curve_owned():
            silent_curve(False)
            curve_owned(False)
    elif args == ["setup"]:
        root_script(POWER_SETUP_SCRIPT, [os.path.join(PLUGIN_DIR, "bin", "rog-deck-power"),
                                         pwd.getpwuid(os.getuid()).pw_name], "power helper setup")
    elif args == ["uninstall"]:
        root_script(POWER_UNINSTALL_SCRIPT, [], "power helper removal")
    else:
        fail("power | power limit <watts> | power off | power setup | power uninstall")


def saver(args):
    if len(args) == 2 and args[0] == "screen" and args[1] in "01234" and len(args[1]) == 1:
        # Two writers would undo each other, so power-profiles-daemon's action goes off first.
        if screen_saving(ppd_props())["ppd"]:
            act(["powerprofilesctl", "configure-action", "amdgpu_panel_power", "--disable"])
        power_helper("panel-power", args[1])
    elif len(args) == 2 and args[0] == "wifi" and args[1] in ("on", "off"):
        power_helper("wifi-powersave", args[1])
    else:
        fail("saver screen <0-4> | saver wifi on|off")


# ------------------------------------------------------------------- gpu

def nvidia_device():
    for dev in glob.glob("/sys/bus/pci/devices/*"):
        if read(dev + "/vendor") == "0x10de" and (read(dev + "/class") or "").startswith("0x03"):
            return dev
    return None


def running_gpu_mode():
    """The mode the laptop booted in. A switch only takes hold on restart."""
    dev = nvidia_device()
    driver = os.path.basename(os.readlink(dev + "/driver")) if dev and os.path.islink(dev + "/driver") else None
    # Gone from the bus, or parked on vfio-pci by supergfxd: Integrated.
    if driver in (None, "vfio-pci"):
        return "integrated"
    # With the MUX on dGPU the NVIDIA card drives the built-in panel itself.
    for conn in glob.glob("/sys/class/drm/card*-eDP-*"):
        if read(conn + "/status") == "connected" and os.path.realpath(conn + "/device/device") == os.path.realpath(dev):
            return "dedicated"
    return "hybrid"


def armoury_attr(name):
    """(current, queued) value of a firmware setting, or (None, None) if absent.

    asusd holds GPU writes (gpu_mux_mode, dgpu_disable) in a queue and makes
    them while the system shuts down; queued is None when nothing is waiting.
    """
    props = get_all(ROOT + "/asus_armoury/" + name, "xyz.ljones.AsusArmoury")
    if not props:
        return None, None
    queued = props.get("QueuedGpuValue")
    return props.get("CurrentValue"), queued if queued is not None and queued >= 0 else None


def supergfxd_mode():
    try:
        with open(SUPERGFXD_CONF) as f:
            return json.load(f).get("mode")
    except (OSError, ValueError, AttributeError):
        return None


def supergfx_mode():
    """supergfxd's configured mode, or None when it isn't set up."""
    return supergfxd_mode() if shutil.which("supergfxctl") else None


def gpu_status():
    mux, mux_queued = armoury_attr("gpu_mux_mode")
    disable, disable_queued = armoury_attr("dgpu_disable")
    if nvidia_device() is None and mux is None and disable is None:
        return None
    gfx = supergfx_mode()
    modes = []
    # supergfxd does Integrated. Without it, the first switch installs it,
    # which needs pacman.
    if gfx is not None or shutil.which("pacman"):
        modes.append("integrated")
    modes.append("hybrid")
    if mux is not None:
        modes.append("dedicated")
    mux_next = mux if mux_queued is None else mux_queued
    if mux_next == 0:
        upcoming = "dedicated"
    # A dgpu_disable=1 that is only queued is left out: asusd's shutdown
    # write of it fails while the NVIDIA driver is loaded (see SUPERGFXD_SCRIPT).
    elif gfx == "Integrated" or (disable == 1 and disable_queued != 0):
        upcoming = "integrated"
    else:
        upcoming = "hybrid"
    running = running_gpu_mode()
    return {"mode": running, "next": upcoming, "modes": modes, "restart": running != upcoming,
            "needsSetup": gfx is None}


def write_supergfxd(mode):
    if mode == "Integrated":
        for source in ("systemd/system/supergfxd.service.d/delay-start.conf", "systemd/system-sleep/force-igpu"):
            source = os.path.join(OMARCHY_PATH, "default", source)
            if not os.path.exists(source):
                fail("Omarchy's %s is missing; can't set up Integrated mode safely" % source)
    try:
        # Long enough for the password prompt plus a first supergfxctl download.
        out = subprocess.run(["pkexec", "/bin/sh", "-c", SUPERGFXD_SCRIPT, "rog-deck-gpu", mode, OMARCHY_PATH],
                             capture_output=True, text=True, timeout=600)
    except FileNotFoundError:
        fail("pkexec is not installed")
    except subprocess.TimeoutExpired:
        fail("timed out waiting for the password prompt")
    if out.returncode in (126, 127):
        fail("GPU switch cancelled: no permission to change %s" % SUPERGFXD_CONF)
    if out.returncode != 0:
        detail = (out.stderr or out.stdout).strip().splitlines()
        fail("could not update %s: %s" % (SUPERGFXD_CONF, detail[-1] if detail else "exit %d" % out.returncode))


def gpu_set(target, restart=False):
    info = gpu_status()
    if not info:
        fail("this laptop has no switchable GPU")
    if target not in info["modes"]:
        fail("%s mode is not available here (choices: %s)" % (target, ", ".join(info["modes"])))
    mux, mux_queued = armoury_attr("gpu_mux_mode")
    disable, disable_queued = armoury_attr("dgpu_disable")

    # 1. supergfxd decides Integrated vs Hybrid at boot while the MUX is on
    # Hybrid. Integrated sets it up if it isn't yet.
    gfx = supergfx_mode()
    if gfx is not None or target == "integrated":
        want = "Integrated" if target == "integrated" else "Hybrid"
        helpers = [os.path.exists(p) for p in (SUPERGFXD_DELAY, FORCE_IGPU_HOOK)]
        settled = all(helpers) if target == "integrated" else not any(helpers)
        if gfx != want or not settled:
            write_supergfxd(want)

    # 2. A firmware-disabled dGPU has to come back before Hybrid or Dedicated.
    # A queued dgpu_disable=1 (from an older ROG Deck) is cancelled for every
    # mode: asusd can't apply it at shutdown, and trying stalls it for 30 s.
    if disable is not None:
        if target == "dedicated" and disable == 1:
            # The kernel refuses the MUX switch while dgpu_disable is still 1,
            # and asusd's shutdown queue doesn't promise the order of writes.
            fail("the dGPU is switched off in firmware: switch to Hybrid and restart first")
        disable_next = disable if disable_queued is None else disable_queued
        if disable_next == 1 and (target != "integrated" or disable_queued == 1):
            act(["asusctl", "armoury", "set", "dgpu_disable", "0"])

    # 3. The MUX: 0 hands the panel to the dGPU, 1 to the iGPU.
    if mux is not None:
        want_mux = 0 if target == "dedicated" else 1
        if (mux if mux_queued is None else mux_queued) != want_mux:
            act(["asusctl", "armoury", "set", "gpu_mux_mode", str(want_mux)])

    info = gpu_status()
    if info["next"] != target:
        fail("the switch to %s didn't take; the laptop will start in %s" % (target, info["next"]))
    print(json.dumps(info, separators=(",", ":")))
    if restart and info["restart"]:
        gpu_restart()


def gpu_restart():
    # Nothing to write here: asusd's asus-shutdown helper holds a shutdown
    # inhibitor and makes the queued firmware writes on the way down.
    reboot = shutil.which("omarchy-system-reboot")
    act([reboot] if reboot else ["systemctl", "reboot"], timeout=30)


def gpu(args):
    if not args:
        print(json.dumps(gpu_status(), separators=(",", ":")))
    elif args[0] == "set" and len(args) in (2, 3) and args[1] in GPU_MODES:
        if len(args) == 3 and args[2] != "--restart":
            fail("unexpected argument: " + args[2])
        gpu_set(args[1], restart=len(args) == 3)
    elif args == ["restart"]:
        gpu_restart()
    else:
        fail("gpu | gpu set <%s> [--restart] | gpu restart" % "|".join(GPU_MODES))


# ------------------------------------------------------------------ fans

def fan_profile_id(mode, choices=None):
    if mode == "balanced":
        return ASUSD_BALANCED
    if mode == "performance":
        return ASUSD_PERFORMANCE
    if mode == "power-saver":
        if choices is None:
            choices = (get_all(ROOT, "xyz.ljones.Platform") or {}).get("PlatformProfileChoices") or []
        return ASUSD_LOWPOWER if ASUSD_LOWPOWER in choices else ASUSD_QUIET
    fail("unknown mode: " + mode)


def to_percent(pwm):
    return round(pwm * 100 / 255)


def to_pwm(percent):
    return max(0, min(255, round(percent * 255 / 100)))


def parse_curve(text):
    points = []
    for part in str(text).split(","):
        t, _, p = part.partition(":")
        try:
            points.append((int(t), int(p.rstrip("%"))))
        except ValueError:
            fail("bad curve point %r (want temp:percent)" % part)
    if len(points) != 8:
        fail("a curve has exactly 8 points, got %d" % len(points))
    for i, (t, p) in enumerate(points):
        if not 0 <= t <= 120 or not 0 <= p <= 100:
            fail("point %d out of range (temp 0-120, percent 0-100)" % (i + 1))
        if i and t < points[i - 1][0]:
            fail("temperatures must not go down (point %d)" % (i + 1))
    return points


def fan_data(profile_id):
    reply = call(ROOT, "xyz.ljones.FanCurves", "FanCurveData", "u", profile_id)
    curves = {}
    for entry in (reply or [[]])[0]:
        fan, pwm, temp, enabled = entry
        curves[fan.lower()] = {
            "enabled": bool(enabled),
            "points": [{"t": t, "p": to_percent(p)} for t, p in zip(temp, pwm)],
        }
    return curves


def fans_status():
    platform = get_all(ROOT, "xyz.ljones.Platform") or {}
    choices = platform.get("PlatformProfileChoices") or []
    result = {}
    for mode in PROFILE_ORDER:
        curves = fan_data(fan_profile_id(mode, choices))
        result[mode] = {
            "custom": any(c["enabled"] for c in curves.values()),
            "fans": curves,
        }
    return result


def fan_set(mode, which, curve):
    profile_id = fan_profile_id(mode)
    points = parse_curve(curve)
    fans = ["cpu", "gpu"] if which == "both" else [which]
    existing = fan_data(profile_id)
    for fan in fans:
        if fan not in existing:
            fail("this laptop has no %s fan curve" % fan)
        # Each point write clears the enable flag in the kernel; SetFanCurve
        # with enabled=true writes all points and then enables, in that order.
        args = [profile_id, fan.upper()]
        args += [to_pwm(p) for _, p in points] + [t for t, _ in points] + ["true"]
        call(ROOT, "xyz.ljones.FanCurves", "SetFanCurve", "u(s(yyyyyyyy)(yyyyyyyy)b)", *args)
    call(ROOT, "xyz.ljones.FanCurves", "SetFanCurvesEnabled", "ub", profile_id, "true")


def fans(args):
    if not args:
        print(json.dumps(fans_status(), separators=(",", ":")))
        return
    command = args[0]
    if command == "set" and len(args) == 4 and args[2] in ("cpu", "gpu", "both"):
        fan_set(args[1], args[2], args[3])
    elif command == "custom" and len(args) == 3:
        call(ROOT, "xyz.ljones.FanCurves", "SetFanCurvesEnabled", "ub",
             fan_profile_id(args[1]), on_off(args[2]))
    elif command == "preset" and len(args) == 3 and args[2] in FAN_PRESETS:
        for fan in ("cpu", "gpu"):
            fan_set(args[1], fan, FAN_PRESETS[args[2]][fan])
    elif command == "reset" and len(args) == 2:
        profile_id = fan_profile_id(args[1])
        call(ROOT, "xyz.ljones.FanCurves", "SetCurvesToDefaults", "u", profile_id)
        call(ROOT, "xyz.ljones.FanCurves", "SetFanCurvesEnabled", "ub", profile_id, "false")
    else:
        fail("unknown fans command: " + " ".join(args))


# --------------------------------------------------------------- updates

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def git(*args, timeout=10):
    """stdout of a git command in the plugin folder, or None if it failed."""
    os.environ["GIT_TERMINAL_PROMPT"] = "0"
    os.environ.setdefault("GIT_SSH_COMMAND", "ssh -oBatchMode=yes")
    return run(["git", "-C", PLUGIN_DIR, *args], timeout=timeout)


def manifest(ref=None):
    text = git("show", ref + ":manifest.json") if ref else read(os.path.join(PLUGIN_DIR, "manifest.json"))
    try:
        data = json.loads(text or "")
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def update(args):
    """`rog-deck update check | apply`, kept for scripts: bin/plugin-update
    does the work, the same updater Batteries and Server Dashboard ship."""
    if args not in (["check"], ["apply"]):
        fail("update check | update apply")
    script = os.path.join(PLUGIN_DIR, "bin", "plugin-update")
    os.execv(sys.executable, [sys.executable, "-B", script, *args])


# ------------------------------------------------------------------ main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    command, args = argv[0], argv[1:]
    if command == "status":
        print(json.dumps(status(), separators=(",", ":")))
    elif command == "profile" and len(args) == 1:
        set_profile(args[0])
    elif command == "takeover":
        takeover()
    elif command == "kbd" and len(args) == 2 and args[0] == "brightness":
        kbd_brightness(args[1])
    elif command == "kbd" and len(args) == 2 and args[0] == "idle-off":
        kbd_idle_off(args[1])
    elif command == "kbd" and args == ["idle-on"]:
        kbd_idle_on()
    elif command == "aura":
        aura(args)
    elif command == "aura-power":
        aura_power(args)
    elif command == "anime":
        anime(args)
    elif command == "battery":
        battery(args)
    elif command == "armoury":
        armoury(args)
    elif command == "refresh" and len(args) == 1:
        refresh(args[0])
    elif command == "fnlock":
        fnlock(args)
    elif command == "power":
        power(args)
    elif command == "saver":
        saver(args)
    elif command == "gpu":
        gpu(args)
    elif command == "fans":
        fans(args)
    elif command == "version" and not args:
        print(manifest().get("version") or "unknown")
    elif command == "update":
        update(args)
    else:
        fail("unknown command: " + " ".join(argv))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Failure as error:
        print("rog-deck: %s" % error, file=sys.stderr)
        sys.exit(1)
    except ValueError as error:
        print("rog-deck: bad value: %s" % error, file=sys.stderr)
        sys.exit(1)
